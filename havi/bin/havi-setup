#!/usr/bin/env bash
# Hosted connector for HAVI.
# Usage: havi-setup <mcp_url> <setup_code>
#
# Exchanges a setup code against the HAVI hosted service, then wires the
# resulting bearer token into Claude Code via `claude mcp add`.
set -eu

ok()   { printf '  \033[1;32m✓\033[0m %s\n' "$*"; }
warn() { printf '  \033[1;33m!\033[0m %s\n' "$*"; }
err()  { printf '  \033[1;31m✗\033[0m %s\n' "$*" >&2; }

MCP_URL="${1:-}"
SETUP_CODE="${2:-}"

if [ -z "$MCP_URL" ] || [ -z "$SETUP_CODE" ]; then
  err "Usage: havi-setup <mcp_url> <setup_code>"
  err "  mcp_url    — HAVI MCP endpoint, e.g. https://havi.ai/api/mcp"
  err "  setup_code — short code shown on the /try connect page"
  exit 1
fi

# Derive exchange URL: same origin, replace path with /api/setup/link/exchange
ORIGIN=$(printf '%s' "$MCP_URL" | sed 's|/api/mcp$||')
EXCHANGE_URL="${ORIGIN}/api/setup/link/exchange"

# POST the device_code to the exchange endpoint
RESPONSE=$(curl -fsS -w '\n%{http_code}' -X POST "$EXCHANGE_URL" \
  -H "Content-Type: application/json" \
  -d "{\"device_code\":\"${SETUP_CODE}\"}" 2>/dev/null) || {
  err "Could not reach exchange endpoint: $EXCHANGE_URL"
  err "Check that the mcp_url origin is correct and reachable."
  exit 1
}

HTTP_BODY=$(printf '%s' "$RESPONSE" | head -n -1)
HTTP_CODE=$(printf '%s' "$RESPONSE" | tail -n 1)

case "$HTTP_CODE" in
  201)
    # Parse token and workspace.id from response body
    if command -v jq >/dev/null 2>&1; then
      TOKEN=$(printf '%s' "$HTTP_BODY" | jq -r '.data.token // empty')
      WORKSPACE_ID=$(printf '%s' "$HTTP_BODY" | jq -r '.data.workspace.id // empty')
    else
      # Portable fallback: extract via sed
      TOKEN=$(printf '%s' "$HTTP_BODY" | sed 's/.*"token":"\([^"]*\)".*/\1/')
      WORKSPACE_ID=$(printf '%s' "$HTTP_BODY" | sed 's/.*"workspace":{[^}]*"id":"\([^"]*\)".*/\1/')
    fi

    if [ -z "$TOKEN" ] || [ -z "$WORKSPACE_ID" ]; then
      err "Exchange succeeded (201) but token or workspace.id missing in response."
      exit 1
    fi

    claude mcp add \
      --transport http \
      --header "Authorization: Bearer ${TOKEN}" \
      --header "x-havi-workspace-id: ${WORKSPACE_ID}" \
      havi "${MCP_URL}"

    ok "HAVI connected."
    ok "MCP server 'havi' registered for workspace ${WORKSPACE_ID}."
    ok "Restart Claude Code for the MCP client to pick up the new server."
    ;;
  202)
    warn "Setup code not approved yet."
    warn "Open the HAVI dashboard and approve the connection request, then run havi-setup again."
    exit 1
    ;;
  400)
    err "Bad request: setup_code is required or malformed (HTTP 400)."
    err "Check that the setup code is correct and try again."
    exit 1
    ;;
  404)
    err "Setup code not found (HTTP 404)."
    err "The code may be incorrect. Check the /try connect page for a fresh code."
    exit 1
    ;;
  409)
    err "Setup code already used (HTTP 409)."
    err "Each setup code can only be exchanged once. Generate a new code on the /try connect page."
    exit 1
    ;;
  410)
    err "Setup code expired (HTTP 410)."
    err "Codes expire after a short window. Generate a new code on the /try connect page."
    exit 1
    ;;
  *)
    err "Unexpected response from exchange endpoint (HTTP ${HTTP_CODE})."
    exit 1
    ;;
esac
